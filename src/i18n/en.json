        "shortDesc": "CPAP: 5 cmH₂O\nTube resistance not compensated"
      },
      "atc": {
        "name": "ATC (Automatic Tube Compensation)",
        "description": "Automatic tube resistance compensation",
        "adultParams": "ATC: 100%\nPEEP: 5 cmH₂O",
        "pediatricParams": "ATC: 100%\nPEEP: 3-5 cmH₂O",
        "difficulty": "Low",
        "shortDesc": "ATC: 100%\nPEEP: 5 cmH₂O"
      }
    },
    "evidenceNote": "Evidence-Based Recommendation: According to the 2024 JAMA Network Open meta-analysis, SBTs performed with PS (5-8 cmH₂O) achieve 7% more successful extubation compared to T-tube (RR: 1.07, 95% CI: 1.04-1.10) without increasing reintubation risk. ATC+CPAP showed higher extubation success than PS (RR: 1.10, 95% CI: 1.00-1.21).",
    "successTitle": "SBT Success Criteria",
    "adultCriteriaTitle": "Adult Criteria (30-120 min)",
    "adultCriteria": [
      "SpO₂ > 90% (or PaO₂ > 60 mmHg)",
      "PaCO₂ increase < 10 mmHg or pH > 7.32",
      "Respiratory rate < 35/min",
      "RSBI (f/VT) < 105",
      "Heart rate < 140 or <20% increase",
      "Systolic BP: 90-180 mmHg",
      "Stable consciousness",
      "No sweating, dyspnea, or retraction"
    ],
    "pediatricCriteriaTitle": "Pediatric Criteria (30-60 min)",
    "pediatricCriteria": [
      "SpO₂ > 92%",
      "Age-appropriate respiratory rate (typically < 50/min)",
      "RSBI: < 8-10 (newborn), < 10-12 (child)",
      "Heart rate increase <20%",
      "Hemodynamic stability",
      "No chest wall retraction",
      "No agitation or sweating"
    ],
    "failureTitle": "SBT Failure Signs",
    "immediateStopTitle": "Immediate Stop Criteria:",
